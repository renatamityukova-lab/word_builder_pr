# Шаблон переменных окружения проекта word_builder.
# Скопируйте в .env и заполните значения. Файл .env в git не попадает.
#   copy word_builder\.env.example word_builder\.env    (Windows cmd)
#   cp word_builder/.env.example word_builder/.env      (bash)
#
# ВАЖНО: реальный ключ хранится только в .env. Не коммитить, не выводить в логи,
# не печатать в консоль и не передавать в сообщения об ошибках.

# Профиль конфигурации: dev | prod.
# Выбирает файл config/config.<APP_ENV>.yaml, который накладывается на config.yaml.
APP_ENV=dev

# API-ключ LLM (обязательно)
OPENAI_API_KEY=your_api_key_here

# Параметры LLM — те же, что в проектах translation и gradio
LLM_PROVIDER=openai
LLM_MODEL=gpt-oss-120b
LLM_FALLBACK_MODEL=MiniMax-M2.7
LLM_BASE_URL=https://llm.enplus.group/v1
LLM_FALLBACK_BASE_URL=
LLM_TRUST_ENV=true
LLM_TIMEOUT_SECONDS=60
# 1 — один повтор для временных ошибок (5xx/429, таймаут/сеть)
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=1500
LLM_MAX_WORDS=100
# low — меньше скрытых рассуждений reasoning-модели, быстрее ответ
LLM_REASONING_EFFORT=low

# Кеш: время жизни записи — 10 минут
CACHE_ENABLED=true
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=600
CACHE_MAX_SIZE=5000

# Правила формирования слов
BUILDER_MAX_INPUT_LENGTH=100
BUILDER_MIN_WORD_LENGTH=2
BUILDER_MAX_RESULTS=300

# Логирование
LOG_ENABLED=true
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_FILE=true
LOG_FILE_PATH=logs/word_builder.log
LOG_JSON_FILE=true
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

# API-слой (если запускаете uvicorn)
APP_HOST=127.0.0.1
APP_PORT=8000

# Gradio UI (main.py)
UI_HOST=127.0.0.1
UI_PORT=7860
# true — публичная ссылка Gradio; для локальной работы оставьте false
UI_SHARE=false
